<div class="container my-5" style="max-width: 420px;">
  <h1 class="h4 text-center mb-4">ログイン</h1>

  <div class="card">
    <div class="card-body">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="mb-3">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="mb-3 form-check">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, "ログイン状態を保持する", class: "form-check-label" %>
          </div>
        <% end %>

        <div class="d-grid">
          <%= f.submit "ログイン", class: "btn btn-primary" %>
        </div>
      <% end %>

      <hr class="my-4">

      <div class="text-center">
        <%= link_to "新規登録はこちら", new_registration_path(resource_name), class: "d-block mb-2" %>
        <%= button_to "ゲストログイン", users_guest_sign_in_path, class: "btn btn-outline-warning btn-sm" %>
      </div>
    </div>
  </div>
</div>