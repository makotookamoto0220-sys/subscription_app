<tr>
  <td class="fw-semibold">
    <%= link_to subscription.name, subscription %>
  </td>
  <td class="text-end"><%= subscription.price %> 円</td>
  <td class="text-center"><%= subscription.payment_day %> 日</td>
  <td class="text-secondary"><%= subscription.category %></td>
  <td class="text-center">
    <% if subscription.active %>
      <span class="badge text-bg-success">使用中</span>
    <% else %>
      <span class="badge text-bg-light border">未使用</span>
    <% end %>
  </td>
  <td class="text-end">
    <%= link_to "編集", edit_subscription_path(subscription), class: "btn btn-sm btn-outline-primary" %>
    <%= link_to "削除", subscription, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-outline-danger" %>
  </td>
</tr>