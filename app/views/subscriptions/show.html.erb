<div class="container my-4" style="max-width: 640px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0"><%= @subscription.name %></h1>
    <%= link_to "← 一覧に戻る", subscriptions_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <div class="card">
    <div class="card-body">
      <table class="table mb-0">
        <tbody>
          <tr><th style="width:140px;">月額料金</th><td><%= @subscription.price %> 円</td></tr>
          <tr><th>支払い方法</th><td><%= @subscription.payment_method %></td></tr>
          <tr><th>支払日</th><td>毎月 <%= @subscription.payment_day %> 日</td></tr>
          <tr><th>カテゴリ</th><td><%= @subscription.category %></td></tr>
          <tr><th>使用状況</th><td><%= @subscription.active ? "使用中" : "未使用" %></td></tr>
          <tr><th>メモ</th><td><%= @subscription.memo %></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-3 d-flex gap-2">
    <%= link_to "編集", edit_subscription_path(@subscription), class: "btn btn-primary" %>
    <%= link_to "削除", @subscription, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-outline-danger" %>
  </div>
</div>