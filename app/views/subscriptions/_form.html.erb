<%= form_with model: subscription, local: true do |f| %>
  <% if subscription.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% subscription.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "サービス名", class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :price, "月額料金（円）", class: "form-label" %>
    <%= f.number_field :price, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :payment_method, "支払い方法", class: "form-label" %>
    <%= f.text_field :payment_method, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :payment_day, "支払日（毎月何日）", class: "form-label" %>
    <%= f.number_field :payment_day, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :category, "カテゴリ", class: "form-label" %>
    <%= f.text_field :category, class: "form-control" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :active, class: "form-check-input" %>
    <%= f.label :active, "使用中", class: "form-check-label" %>
  </div>

  <div class="mb-3">
    <%= f.label :memo, "メモ", class: "form-label" %>
    <%= f.text_area :memo, class: "form-control", rows: 3 %>
  </div>

  <%= f.submit "保存", class: "btn btn-primary" %>
<% end %>