<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">登録中のサブスク</h1>
    <%= link_to "サブスクを追加", new_subscription_path, class: "btn btn-primary btn-sm" %>
  </div>
  <%= form_with url: subscriptions_path, method: :get, local: true do |f| %>
    <div class="input-group mb-3">
      <%= f.text_field :keyword, value: params[:keyword], class: "form-control", placeholder: "サービス名で検索" %>
      <%= f.submit "検索", class: "btn btn-primary" %>
    </div>
  <% end %>

  <div class="card mb-4">
    <div class="card-body d-flex align-items-baseline gap-2">
      <span class="text-secondary small">今月の合計</span>
      <span class="fs-4 fw-semibold"><%= @subscriptions.sum(&:price) %></span>
      <span class="text-secondary small">円 / 月</span>
    </div>
  </div>

  <div class="card">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>サービス</th>
          <th class="text-end">月額</th>
          <th class="text-center">支払日</th>
          <th>カテゴリ</th>
          <th class="text-center">状態</th>
          <th class="text-end">操作</th>
        </tr>
      </thead>
      <tbody>
        <%= render @subscriptions %>
      </tbody>
    </table>
  </div>
</div>